<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<launchConfiguration type="org.lamport.tla.toolbox.tool.tlc.modelCheck">
    <stringAttribute key="configurationName" value="Model_1"/>
    <intAttribute key="distributedFPSetCount" value="0"/>
    <stringAttribute key="distributedNetworkInterface" value="192.168.0.176"/>
    <intAttribute key="distributedNodesCount" value="1"/>
    <stringAttribute key="distributedTLC" value="off"/>
    <intAttribute key="fpIndex" value="85"/>
    <intAttribute key="maxHeapSize" value="25"/>
    <stringAttribute key="modelBehaviorInit" value="/\ pc = ( 0 :&gt; &quot;ncs&quot; @@&#10;  1 :&gt; &quot;ncs&quot; @@&#10;  2 :&gt; &quot;ncs&quot; @@&#10;  3 :&gt; &quot;ncs&quot; @@&#10;  4 :&gt; &quot;ncs&quot; @@&#10;  5 :&gt; &quot;ncs&quot; @@&#10;  6 :&gt; &quot;ncs&quot; )&#10;/\ turn = 0"/>
    <stringAttribute key="modelBehaviorNext" value=""/>
    <stringAttribute key="modelBehaviorSpec" value="Spec"/>
    <intAttribute key="modelBehaviorSpecType" value="1"/>
    <stringAttribute key="modelBehaviorVars" value="pc, turn"/>
    <stringAttribute key="modelComments" value=""/>
    <booleanAttribute key="modelCorrectnessCheckDeadlock" value="true"/>
    <listAttribute key="modelCorrectnessInvariants">
        <listEntry value="1~ (\E id1,id2 \in Procs : id1/=id2 /\ pc[id1]=&quot;cs&quot; /\ pc[id2]=&quot;cs&quot;)"/>
        <listEntry value="1\A self \in ProcSet : pc[self]=&quot;cs&quot; =&gt; (self=turn)"/>
    </listAttribute>
    <listAttribute key="modelCorrectnessProperties">
        <listEntry value="1\A t \in 0..(N-1): []&lt;&gt;(pc[turn] = &quot;cs&quot; /\ turn=t)&#13;&#10;(*means that each process enters to the critical section infinite many times*)"/>
    </listAttribute>
    <intAttribute key="modelEditorOpenTabs" value="8"/>
    <stringAttribute key="modelExpressionEval" value=""/>
    <listAttribute key="modelParameterConstants">
        <listEntry value="N;;7;0;0"/>
        <listEntry value="Procs;;0..(N-1);0;0"/>
    </listAttribute>
    <intAttribute key="modelVersion" value="20191005"/>
    <intAttribute key="numberOfWorkers" value="6"/>
    <stringAttribute key="result.mail.address" value=""/>
    <stringAttribute key="specName" value="Session9_ex1"/>
    <stringAttribute key="tlcResourcesProfile" value="local custom"/>
</launchConfiguration>
