        <listEntry value="1~ (\E id1,id2 \in Procs : id1/=id2 /\ pc[id1]=&quot;cs&quot; /\ pc[id2]=&quot;cs&quot;)"/>
        <listEntry value="1/\ (\E id1 \in Procs : pc[id1]=&quot;cs&quot; =&gt; (\A id2 \in Procs : (id1/=id2) =&gt; (~(~ flag[1 - id2])))) (*if there exists processes in cs then await conditions of others are false*)&#13;&#10;/\ (\E id1 \in Procs : pc[id1]=&quot;cs&quot; =&gt; (\A id2 \in Procs: (id1/=id2) =&gt; ((~ flag[1 - id2]) &lt;=&gt; (pc[id2]=&quot;cs&quot;)))) (*if there  processes in cs then other process is in cs if only if its await condition is true*)"/>
    </listAttribute>
